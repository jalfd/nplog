cflags = -Wall -std=c++17 -g
ldflags = 
objdir = obj
bindir = bin

rule cc
  depfile = $out.d
  description = Compiling C++ file $out
  command = clang++ $cflags -MMD -MF $out.d -I../Catch2/single_include -c $in -o $out
rule link
  description = linking C++ file $out
  command = clang++ $ldflags $in -o $out

build $objdir/tests.o: cc tests.cc
build $objdir/frontend-test.o: cc frontend-test.cc
build $objdir/macros-test.o: cc macros-test.cc
build $objdir/macros-sandbox.o: cc macros-sandbox.cc
build $bindir/tests: link $objdir/tests.o $objdir/frontend-test.o $objdir/macros-test.o
build $bindir/macros: link $objdir/macros-sandbox.o

